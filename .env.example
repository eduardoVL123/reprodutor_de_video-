# Copie para .env.local e preencha. Nenhum valor aqui é obrigatório.

# Endereço da lista de demonstração (docs/demo/pulse-demo.m3u publicada, ex.: link "raw" do GitHub).
# Vazio = o login não mostra o botão "Experimentar com vídeos de demonstração".
VITE_DEMO_PLAYLIST_URL=

# Endereço (https, sem barra final) do servidor de pareamento pelo celular (RFC-016, server/pair).
# Vazio = o login não oferece "adicionar pelo celular" e continua só com o teclado do controle.
# Local: http://localhost:8788 (com `npm run pair`).
VITE_PAIR_BASE_URL=

# Endereço (sem barra final) do serviço de licença (RFC-018, server/license): teste de 7 dias, ativos por parceiro e
# ativação anual. Vazio = o app não fala com o serviço e funciona como antes. Local: http://127.0.0.1:8789 (`npm run license`).
VITE_LICENSE_BASE_URL=
# 1 = versão das lojas: a tela de bloqueio não mostra preço nem QR de pagamento (RFC-018, D4).
VITE_LICENSE_STORE_BUILD=

# Só para o servidor `npm run license` (não vão para o app):
# LICENSE_ADMIN_TOKEN=   senha do painel /admin/ (vazio = painel fechado)
# LICENSE_CONTACT_URL=   link de contato para pagar a ativação (ex.: WhatsApp), mostrado na página de planos
# LICENSE_PORT=8789  LICENSE_HOST=127.0.0.1  LICENSE_DB_PATH=server/license/.data/license.db
