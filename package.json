{
  "name": "pulse-player",
  "version": "1.2.0",
  "private": true,
  "description": "Reprodutor de mídia genérico (casca vazia) para Smart TVs Tizen e webOS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "mock": "node scripts/mock-xtream.mjs",
    "pair": "node server/pair/pair-server.mjs",
    "pair:dev": "wrangler dev --config server/pair/wrangler.jsonc --port 8788",
    "pair:deploy": "wrangler deploy --config server/pair/wrangler.jsonc",
    "license": "node server/license/license-server.mjs",
    "license:dev": "wrangler dev --config server/license/wrangler.jsonc --port 8789",
    "license:deploy": "wrangler deploy --config server/license/wrangler.jsonc",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build:tizen": "vite build && node scripts/package-tv.mjs tizen",
    "build:webos": "vite build && node scripts/package-tv.mjs webos",
    "icons": "node scripts/make-tv-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.3",
    "hls.js": "^1.7.3",
    "localforage": "^1.10.0",
    "pinia": "^4.0.3",
    "qrcode-generator": "^1.4.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
