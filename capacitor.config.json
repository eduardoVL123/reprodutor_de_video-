{
  "appId": "com.playerpulse.app",
  "appName": "Pulse Player",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "hostname": "localhost",
    "cleartext": true
  },
  "android": {
    "captureInput": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "SystemBars": {
      "hidden": true,
      "initialViewportFitValueHint": "cover",
      "insetsHandling": "disable"
    }
  }
}
