{
  "appId": "com.neutrotv.player",
  "appName": "Neutro TV",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "hostname": "localhost",
    "cleartext": true,
    "allowNavigation": ["*"]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
