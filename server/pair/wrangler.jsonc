{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse-pair",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR",
        "class_name": "PairHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairHub"]
    }
  ],
  "observability": {
    "enabled": false
  }
}
