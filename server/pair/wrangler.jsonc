{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse-pair",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR",
        "class_name": "PairHub"
      }
    ]
  },
  // Limite por rede antes do Durable Object (worker.mjs). 1500/min: o hub aceita 1200 consultas/min por IP (40 TVs
  // atrás do mesmo CGNAT) mais as chamadas dos celulares. Contagem por local do Cloudflare e aproximada (doc oficial).
  "ratelimits": [
    { "name": "PAIR_LIMIT", "namespace_id": "1701", "simple": { "limit": 1500, "period": 60 } }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairHub"]
    }
  ],
  // Desligado de propósito: a política de privacidade (PRIVACY.md, "Use o seu celular") promete o serviço sem logs.
  "observability": { "enabled": false }
}
