{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse-pair",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIR",
        "class_name": "PairHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PairHub"]
    }
  ],
  // Só os avisos do código (console.warn); sem log por requisição, que guardaria a URL com códigos de aparelho.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
