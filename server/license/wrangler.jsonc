// Serviço de licença (RFC-018) no Cloudflare Workers + D1. Segredo: `wrangler secret put LICENSE_ADMIN_TOKEN`.
// Publicar: `npm run license:deploy` (na pasta reprodutor_de_video).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pulse-license",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pulse-license",
      "database_id": "e2ec8854-04d9-45f8-b138-39b3bcbfb4b0"
    }
  ],
  // Atendimento e vendas pelo WhatsApp no site (RFC-021) e na página do QR da TV.
  // RFC-025: quando existirem, entram aqui (o deploy sobrescreve o que estiver só no painel) "PLAY_URL" (link da Google Play). ACCESS_TEAM = equipe do
  // Zero Trust (shy-mountain-9579.cloudflareaccess.com). ACCESS_AUD, ACCESS_OWNER_EMAIL e LICENSE_REPORT_TOKEN
  // são segredos: `wrangler secret put`.
  "vars": { "LICENSE_CONTACT_URL": "https://wa.me/5516992791692", "ACCESS_TEAM": "shy-mountain-9579",
    // Chave PÚBLICA do Mercado Pago (cartão em /pagar). De PRODUÇÃO desde 2026-11-10 (scripts/mp-producao.sh).
    "MP_PUBLIC_KEY": "APP_USR-008728eb-19f1-4312-9799-65f15ea3684b" },
  // De hora em hora: conferência de estornos cujo webhook se perdeu. A limpeza da guarda de 24 meses (PRIVACY.md) roda
  // só na rodada das 6h UTC (worker.mjs).
  "triggers": { "crons": ["0 * * * *"] },
  // Só os avisos do código (console.warn); sem log por requisição, que guardaria a URL com códigos de aparelho.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
