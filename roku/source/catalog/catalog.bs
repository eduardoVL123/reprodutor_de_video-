import "pkg:/source/utils/types.bs"
import "pkg:/source/xtream/errors.bs"
import "pkg:/source/xtream/api.bs"
import "pkg:/source/xtream/m3uParser.bs"
' Port de src/services/catalogDb.js, da carga de src/stores/catalogStore.js e de src/utils/normalizeText.js (casos em
' tests/catalogDb.test.js, tests/parental.test.js, tests/catalogStore.m3u.test.js e catalog.spec.bs).
' Mesmo formato do web, em arquivos no lugar do IndexedDB (um diretório por seção):
'   meta.json        { version, count, chunkSize, chunkCount, counts:{catId:n}, updatedAt }
'   categories.json  categorias como vieram da API
'   index.json       { catId: [posição global, ...] }
'   chunk-N.json     até CHUNK_SIZE itens
'   search.json      [nome normalizado, ...] na ordem das posições
' Roda num Task node. O diretório padrão (DEFAULT_DIR) é cachefs:/catalog (some no reboot: o próximo boot baixa a lista de novo).
' Categorias fora da vista (controle parental) entram como parâmetro `hidden` em vez do estado do módulo web.
namespace catalog

    const DEFAULT_DIR = "cachefs:/catalog"
    const CHUNK_SIZE = 500
    const ALL_CATEGORIES = "all"
    ' Sobe quando o formato dos itens salvos muda: catálogos antigos são baixados de novo.
    const CATALOG_VERSION = 4
    ' Espaço que o catálogo sempre deixa livre no cachefs (o sistema e as outras gravações do app precisam dele).
    const DISK_RESERVE_BYTES = 4194304
    ' Por item, o que o índice por categoria e o de busca ainda vão ocupar depois dos chunks.
    const INDEX_BYTES_PER_ITEM = 48
    ' Listas grandes (50.000+ itens) podem demorar bem mais que um login.
    const CATALOG_TIMEOUT_MS = 120000
    ' Espera máxima pela carga de outra Task (duas requisições de CATALOG_TIMEOUT_MS mais a gravação).
    const SHARED_WAIT_MS = 300000
    const CLAIM_SETTLE_MS = 300

    ' ---------- Texto ----------

    ' Equivalente ao normalize('NFD') + remoção dos acentos para as letras latinas acentuadas.
    ' shortcut: letras fora desta tabela (ex.: vietnamita) ficam com acento; ampliar se aparecer lista assim.
    function accentTable() as object
        return {
            a: "àáâãäåāăą", c: "çćĉċč", d: "ď", e: "èéêëēĕėęě", g: "ĝğġģ", h: "ĥ", i: "ìíîïĩīĭį", j: "ĵ", k: "ķ",
            l: "ĺļľ", n: "ñńņň", o: "òóôõöōŏő", r: "ŕŗř", s: "śŝşš", t: "ţť", u: "ùúûüũūŭůűų", w: "ŵ", y: "ýÿŷ", z: "źżž"
        }
    end function

    ' Remove acentos e passa para minúsculas, sem mexer na pontuação.
    function foldText(text as dynamic) as string
        folded = LCase(utils.textOr(text, ""))
        table = catalog.accentTable()
        for each base in table
            folded = CreateObject("roRegex", "[" + table[base] + "]", "").replaceAll(folded, base)
        end for
        return folded
    end function

    ' Forma canônica para busca: "Homem-Aranha: Longe de Casa" => "homem aranha longe de casa". Mantém letras
    ' latinas sem acento, dígitos e alfabetos não latinos (grego, cirílico, CJK...); o resto vira espaço.
    function normalizeText(text as dynamic) as string
        nonWord = CreateObject("roRegex", "[^0-9a-z\x{0370}-\x{1FFF}\x{2C00}-\x{D7FF}\x{F900}-\x{FDFF}]+", "")
        return nonWord.replaceAll(catalog.foldText(text), " ").trim()
    end function

    ' ---------- Arquivos ----------

    function sectionDir(dir as string, section as string) as string
        return dir + "/" + section
    end function

    function readJsonFile(path as string) as dynamic
        if not CreateObject("roFileSystem").exists(path) then return invalid
        return ParseJson(ReadAsciiFile(path))
    end function

    sub deleteTree(path as string)
        fs = CreateObject("roFileSystem")
        if not fs.exists(path) then return
        for each name in fs.getDirectoryListing(path)
            catalog.deleteTree(path + "/" + name)
        end for
        DeleteFile(path)
        fs.delete(path)
    end sub

    ' Remove todo o catálogo (logout / troca de conta).
    sub clearCatalog(dir as string)
        catalog.deleteTree(dir)
    end sub

    ' ---------- Gravação ----------

    ' Categorias do item: a principal (category_id) e as extras (category_ids, painéis Xtream novos).
    function categoriesOf(item as dynamic) as object
        if not utils.isObject(item) then return ["none"]
        candidates = [item.category_id]
        if GetInterface(item.category_ids, "ifArray") <> invalid then candidates.append(item.category_ids)
        unique = []
        seen = {}
        for each id in candidates
            key = utils.textOr(id, "")
            if utils.isNumber(id) and id = 0 then key = "0"
            if key <> "" and not seen.doesExist(key) then
                seen[key] = true
                unique.push(key)
            end if
        end for
        if unique.count() = 0 then return ["none"]
        return unique
    end function

    ' Item como o web grava: stream_id (ou series_id), capa em stream_icon, extensão padrão e seção.
    function normalizeItem(raw as dynamic, section as string) as dynamic
        if not utils.isObject(raw) then return raw
        item = {}
        item.append(raw)
        streamId = raw.stream_id
        if streamId = invalid then streamId = raw.series_id
        item["stream_id"] = streamId
        item["series_id"] = streamId
        item["stream_icon"] = utils.textOr(raw.stream_icon, utils.textOr(raw.cover, ""))
        extension = utils.textOr(raw.container_extension, "")
        if extension = "" and (section = "vod" or section = "series") then extension = "mp4"
        item["container_extension"] = extension
        item["section"] = utils.textOr(raw.section, section)
        ' Campos que o app nunca lê: fora, senão 50 mil canais não cabem no disco da Roku (o web grava o item inteiro).
        for each unused in ["stream_type", "epg_channel_id", "custom_sid", "tv_archive", "tv_archive_duration"]
            item.delete(unused)
        end for
        if utils.textOr(item.direct_source, "") = "" then item.delete("direct_source")
        return item
    end function

    ' ---------- Formato compacto dos chunks ----------
    ' Cada item vira uma lista de valores na ordem de itemFields() (sem repetir os nomes dos campos 50 mil vezes); o
    ' começo comum dos links de capa fica uma vez por chunk. series_id (= stream_id) e section (= a da pasta) não são
    ' gravados. Campo ausente vira null e continua ausente ao ler; o que não está na lista vai num objeto no fim.

    function itemFields() as object
        return ["stream_id", "name", "stream_icon", "category_id", "category_ids", "container_extension", "added", "last_modified", "num", "rating", "directUrl", "direct_source"]
    end function

    ' chunk = { p: [começos de link], i: [[valores...]] }
    function packChunk(items as object) as object
        prefixes = []
        prefixIndex = {}
        prefixIndex.setModeCaseSensitive()
        packed = []
        fields = catalog.itemFields()
        for each item in items
            row = []
            extras = {}
            if utils.isObject(item) then
                extras.append(item)
                for each field in fields
                    value = item[field]
                    extras.delete(field)
                    if field = "stream_icon" and utils.isString(value) then
                        cut = 0
                        for i = Len(value) to 1 step -1
                            if Mid(value, i, 1) = "/" then
                                cut = i
                                exit for
                            end if
                        end for
                        if cut > 0 then
                            head = Left(value, cut)
                            if not prefixIndex.doesExist(head) then
                                prefixIndex[head] = prefixes.count()
                                prefixes.push(head)
                            end if
                            value = [prefixIndex[head], Mid(value, cut + 1)]
                        end if
                    end if
                    row.push(value)
                end for
                extras.delete("series_id")
                extras.delete("section")
            end if
            if extras.count() > 0 then row.push(extras)
            packed.push(row)
        end for
        return { p: prefixes, i: packed }
    end function

    function unpackChunk(chunk as dynamic, section as string) as object
        items = []
        if not utils.isObject(chunk) or GetInterface(chunk.i, "ifArray") = invalid then return items
        fields = catalog.itemFields()
        for each row in chunk.i
            item = {}
            if GetInterface(row, "ifArray") <> invalid then
                for i = 0 to fields.count() - 1
                    if i < row.count() and row[i] <> invalid then
                        value = row[i]
                        if fields[i] = "stream_icon" and GetInterface(value, "ifArray") <> invalid then value = chunk.p[value[0]] + value[1]
                        item[fields[i]] = value
                    end if
                end for
                if row.count() > fields.count() and utils.isObject(row[fields.count()]) then item.append(row[fields.count()])
                if item.stream_id <> invalid then item["series_id"] = item.stream_id
                item["section"] = section
            end if
            items.push(item)
        end for
        return items
    end function

    ' ---------- Espaço em disco ----------

    ' Bytes livres no volume (invalid se o aparelho não informa: aí vale só a falha da gravação).
    function freeBytes(path as string) as dynamic
        volume = "cachefs:"
        if Instr(1, path, ":") > 0 then volume = Left(path, Instr(1, path, ":"))
        info = CreateObject("roFileSystem").GetVolumeInfo(volume)
        if not utils.isObject(info) or not utils.isNumber(info.freeblocks) or not utils.isNumber(info.blocksize) then return invalid
        return info.freeblocks * info.blocksize
    end function

    ' Só a lista ativa fica no disco: os catálogos das outras listas saem antes de gravar (senão se acumulam).
    sub pruneOtherLists(dir as string)
        parent = catalog.DEFAULT_DIR + "/"
        if Left(dir, Len(parent)) <> parent then return
        fs = CreateObject("roFileSystem")
        if not fs.exists(catalog.DEFAULT_DIR) then return
        own = Mid(dir, Len(parent) + 1)
        for each name in fs.getDirectoryListing(catalog.DEFAULT_DIR)
            if name <> own then catalog.deleteTree(parent + name)
        end for
    end sub

    ' Grava a seção em pedaços, com o índice por categoria e o de busca. Substitui o que havia.
    ' Nunca enche o disco: antes de cada chunk confere o espaço livre (deixando DISK_RESERVE_BYTES e o que os índices
    ' vão ocupar); se não couber, ou se a gravação falhar, a seção fica com os itens que couberam (meta.truncated) em vez
    ' de vazia. budget = limite de bytes para os testes (-1: o espaço livre do volume).
    sub saveSection(dir as string, section as string, categories as object, streams as object, budget = -1 as double)
        path = catalog.sectionDir(dir, section)
        catalog.deleteTree(path)
        catalog.pruneOtherLists(dir)
        ' CreateDirectory não cria os pais: a pasta da lista fica em cachefs:/catalog, que some no reboot.
        slash = Instr(Instr(1, dir, ":/") + 2, dir, "/")
        while slash > 0
            CreateDirectory(Left(dir, slash - 1))
            slash = Instr(slash + 1, dir, "/")
        end while
        CreateDirectory(dir)
        CreateDirectory(path)
        total = streams.count()
        chunkCount = (total + catalog.CHUNK_SIZE - 1) \ catalog.CHUNK_SIZE
        free = budget
        if free < 0 then free = catalog.freeBytes(dir)
        used = 0#
        written = 0
        names = []
        writtenChunks = 0
        for n = 0 to chunkCount - 1
            base = n * catalog.CHUNK_SIZE
            last = base + catalog.CHUNK_SIZE - 1
            if last > total - 1 then last = total - 1
            items = []
            chunkNames = []
            for p = base to last
                item = catalog.normalizeItem(streams[p], section)
                items.push(item)
                name = invalid
                if utils.isObject(item) then name = item.name
                chunkNames.push(catalog.normalizeText(name))
            end for
            text = FormatJson(catalog.packChunk(items))
            need = Len(text) + (last + 1) * catalog.INDEX_BYTES_PER_ITEM
            if budget < 0 and free <> invalid then need = need + catalog.DISK_RESERVE_BYTES
            if free <> invalid and used + need > free then exit for
            file = path + "/chunk-" + n.toStr() + ".json"
            if not WriteAsciiFile(file, text) then
                DeleteFile(file)
                exit for
            end if
            used = used + Len(text)
            written = last + 1
            writtenChunks = n + 1
            names.append(chunkNames)
        end for

        ' Índices só com o que coube; se ainda faltar espaço para eles, o último chunk sai e tenta de novo.
        while true
            index = {}
            index.setModeCaseSensitive()
            for p = 0 to written - 1
                for each cat in catalog.categoriesOf(streams[p])
                    if not index.doesExist(cat) then index[cat] = []
                    index[cat].push(p)
                end for
            end for
            counts = {}
            counts.setModeCaseSensitive()
            for each cat in index
                counts[cat] = index[cat].count()
            end for
            ok = WriteAsciiFile(path + "/categories.json", FormatJson(categories)) and WriteAsciiFile(path + "/index.json", FormatJson(index))
            if ok then
                ' O índice de busca pode faltar: getSearchIndex o refaz pelos chunks (como o buildSearchIndex do web).
                if not WriteAsciiFile(path + "/search.json", FormatJson(names)) then DeleteFile(path + "/search.json")
                meta = { version: catalog.CATALOG_VERSION, count: written, total: total, truncated: written < total, chunkSize: catalog.CHUNK_SIZE, chunkCount: writtenChunks, counts: counts, updatedAt: CreateObject("roDateTime").toISOString() }
                ok = WriteAsciiFile(path + "/meta.json", FormatJson(meta))
            end if
            if ok or writtenChunks = 0 then exit while
            writtenChunks = writtenChunks - 1
            DeleteFile(path + "/chunk-" + writtenChunks.toStr() + ".json")
            written = writtenChunks * catalog.CHUNK_SIZE
            if written > total then written = total
            names = []
            for p = 0 to written - 1
                names.push(catalog.normalizeText(streams[p].name))
            end for
        end while
        if written < total then print "[catalog] Seção "; section; " grande demais para o disco: guardados "; written; " de "; total; " itens."
    end sub

    ' ---------- Leitura ----------

    function getMeta(dir as string, section as string) as dynamic
        meta = catalog.readJsonFile(catalog.sectionDir(dir, section) + "/meta.json")
        if not utils.isObject(meta) or meta.version <> catalog.CATALOG_VERSION then return invalid
        return meta
    end function

    function getCategories(dir as string, section as string) as object
        cats = catalog.readJsonFile(catalog.sectionDir(dir, section) + "/categories.json")
        if GetInterface(cats, "ifArray") = invalid then return []
        return cats
    end function

    function getIndex(dir as string, section as string) as object
        index = catalog.readJsonFile(catalog.sectionDir(dir, section) + "/index.json")
        if not utils.isObject(index) then return {}
        return index
    end function

    ' Nomes normalizados da seção pela posição global (vazio se a seção não foi baixada). Sem o search.json, ou com
    ' tamanho diferente do resumo, refaz pelos chunks e tenta gravar de novo (buildSearchIndex do web).
    function getSearchIndex(dir as string, section as string) as object
        meta = catalog.getMeta(dir, section)
        if meta = invalid then return []
        path = catalog.sectionDir(dir, section)
        names = catalog.readJsonFile(path + "/search.json")
        if GetInterface(names, "ifArray") <> invalid and names.count() = meta.count then return names
        names = []
        for n = 0 to meta.chunkCount - 1
            chunk = catalog.unpackChunk(catalog.readJsonFile(path + "/chunk-" + n.toStr() + ".json"), section)
            if chunk.count() > 0 then
                for each item in chunk
                    name = invalid
                    if utils.isObject(item) then name = item.name
                    names.push(catalog.normalizeText(name))
                end for
            end if
        end for
        WriteAsciiFile(path + "/search.json", FormatJson(names))
        return names
    end function

    ' Posições bloqueadas pelas categorias fora da vista; invalid = nada escondido.
    function blockedPositions(dir as string, section as string, hidden as object) as dynamic
        if hidden.count() = 0 then return invalid
        index = catalog.getIndex(dir, section)
        blocked = {}
        for each id in hidden
            positions = index[utils.textOr(id, "")]
            if positions <> invalid then
                for each p in positions
                    blocked[p.toStr()] = true
                end for
            end if
        end for
        return blocked
    end function

    ' Quantos itens "Todos" mostra com o filtro (invalid = sem filtro: vale o total do catálogo).
    function visibleCount(dir as string, section as string, hidden as object) as dynamic
        meta = catalog.getMeta(dir, section)
        blocked = catalog.blockedPositions(dir, section, hidden)
        if meta = invalid or blocked = invalid then return invalid
        return meta.count - blocked.count()
    end function

    ' Itens visíveis por categoria com o filtro (invalid = sem filtro: valem as contagens do catálogo).
    function visibleCategoryCounts(dir as string, section as string, hidden as object) as dynamic
        blocked = catalog.blockedPositions(dir, section, hidden)
        if blocked = invalid then return invalid
        index = catalog.getIndex(dir, section)
        counts = {}
        counts.setModeCaseSensitive()
        for each id in index
            n = 0
            for each p in index[id]
                if not blocked.doesExist(p.toStr()) then n = n + 1
            end for
            counts[id] = n
        end for
        return counts
    end function

    ' Itens [start, start+count) da categoria (ALL_CATEGORIES = "Todos"), sem os das categorias fora da vista.
    function getItems(dir as string, section as string, categoryId as string, start as integer, count as integer, hidden as object) as object
        meta = catalog.getMeta(dir, section)
        if meta = invalid or count <= 0 then return []
        blocked = catalog.blockedPositions(dir, section, hidden)
        if categoryId = catalog.ALL_CATEGORIES then
            candidates = invalid ' todas as posições, em ordem
        else
            candidates = catalog.getIndex(dir, section)[categoryId]
            if candidates = invalid then return []
        end if
        positions = []
        skipped = 0
        total = meta.count
        if candidates <> invalid then total = candidates.count()
        for i = 0 to total - 1
            p = i
            if candidates <> invalid then p = candidates[i]
            if blocked = invalid or not blocked.doesExist(p.toStr()) then
                if skipped >= start then
                    positions.push(p)
                    if positions.count() >= count then exit for
                else
                    skipped = skipped + 1
                end if
            end if
        end for
        return catalog.getItemsAt(dir, section, positions)
    end function

    ' Itens nas posições globais informadas (ex.: resultados da busca), na mesma ordem.
    function getItemsAt(dir as string, section as string, positions as object) as object
        meta = catalog.getMeta(dir, section)
        if meta = invalid or positions.count() = 0 then return []
        chunks = {}
        items = []
        for each p in positions
            n = p \ meta.chunkSize
            key = n.toStr()
            if not chunks.doesExist(key) then chunks[key] = catalog.unpackChunk(catalog.readJsonFile(catalog.sectionDir(dir, section) + "/chunk-" + key + ".json"), section)
            chunk = chunks[key]
            if GetInterface(chunk, "ifArray") <> invalid then
                item = chunk[p mod meta.chunkSize]
                if item <> invalid then items.push(item)
            end if
        end for
        return items
    end function

    ' Categorias para a tela: "Todos" primeiro e só as que têm itens (publish do catalogStore).
    function publishList(dir as string, section as string) as object
        meta = catalog.getMeta(dir, section)
        if meta = invalid then return []
        list = [{ category_id: catalog.ALL_CATEGORIES, category_name: "Todos", count: meta.count }]
        for each cat in catalog.getCategories(dir, section)
            id = utils.textOr(cat.category_id, "")
            if utils.isNumber(cat.category_id) and cat.category_id = 0 then id = "0"
            count = meta.counts[id]
            if count <> invalid and count > 0 then list.push({ category_id: id, category_name: utils.textOr(cat.category_name, ""), count: count })
        end for
        return list
    end function

    ' ---------- Carga (catalogStore) ----------

    ' ctx das cargas para a sessão aberta. Uma pasta por lista (hash do id): trocar de lista nunca lê o catálogo da
    ' anterior, nem o que uma carga antiga ainda em andamento gravar depois da troca.
    function contextFor(current as object) as object
        apiBase = utils.textOr(current.resolvedUrl, "")
        if apiBase = "" then apiBase = utils.textOr(current.baseUrl, "")
        dir = catalog.DEFAULT_DIR + "/" + xtream.hashText(utils.textOr(current.id, ""))
        return { dir: dir, apiBase: apiBase, credentials: { username: current.username, password: current.password }, type: current.type }
    end function

    function actions(section as string) as object
        if section = "live" then return { categories: "get_live_categories", streams: "get_live_streams" }
        if section = "vod" then return { categories: "get_vod_categories", streams: "get_vod_streams" }
        return { categories: "get_series_categories", streams: "get_series" }
    end function

    ' Lista da API; false/null de alguns painéis vira lista vazia. { list, error }
    function requestList(transport as object, ctx as object, action as string) as object
        result = xtream.apiRequest(transport, ctx.apiBase, ctx.credentials, { action: action, timeoutMs: catalog.CATALOG_TIMEOUT_MS })
        if result.error <> invalid then return { list: invalid, error: result.error }
        data = result.data
        if data = invalid or (GetInterface(data, "ifBoolean") <> invalid and not data) then return { list: [], error: invalid }
        if GetInterface(data, "ifArray") = invalid then return { list: invalid, error: xtream.newError("bad_response", action + " não retornou uma lista") }
        return { list: data, error: invalid }
    end function

    ' Séries: o id vem em series_id, a capa em cover e o nome às vezes em title.
    function remapSeries(list as object) as object
        for i = 0 to list.count() - 1
            item = list[i]
            if utils.isObject(item) then
                seriesId = item.series_id
                if seriesId = invalid then seriesId = item.stream_id
                item["stream_id"] = seriesId
                item["series_id"] = seriesId
                item["stream_icon"] = utils.textOr(item.cover, utils.textOr(item.stream_icon, ""))
                item["name"] = utils.textOr(item.name, utils.textOr(item.title, ""))
                item["container_extension"] = "mp4"
                item["section"] = "series"
            end if
        end for
        return list
    end function

    ' Playlist M3U: uma leitura grava as três seções (M3U não tem séries: a seção fica vazia).
    function importM3u(transport as object, ctx as object) as dynamic
        fetched = xtream.fetchM3uText(transport, ctx.apiBase)
        if fetched.error <> invalid then return fetched.error
        read = xtream.readM3u(fetched.text)
        if read.error <> invalid then return read.error
        catalog.saveSection(ctx.dir, "live", read.parsed.liveCategories, read.parsed.liveStreams)
        catalog.saveSection(ctx.dir, "vod", read.parsed.vodCategories, read.parsed.vodStreams)
        catalog.saveSection(ctx.dir, "series", [], [])
        return invalid
    end function

    function loadFailure(err as dynamic, section as string) as object
        described = xtream.describeError(err)
        print "[catalog] Falha ao carregar "; section; ": "; described.detail
        return { ok: false, error: described.message, errorDetail: described.detail, list: [] }
    end function

    ' Carrega do cache se houver; senão baixa da API (ou da playlist M3U) e grava.
    ' ctx = { dir, apiBase, credentials, type }. { ok, error, errorDetail, list }
    ' loadSection sem baixar a mesma seção duas vezes ao mesmo tempo (o Início e a aba abrem juntos): como a promessa
    ' em andamento do catalogStore, quem chega depois espera a primeira terminar e lê o que ela gravou.
    ' Dono da seção no campo m.global["catalogLoad_" + seção] (criado pela MainScene; "" = livre); sem ele, carrega direto.
    ' Dona que some (Task morta por falta de memória) perde a vez depois de maxWaitMs sem trocar de dono.
    function loadShared(transport as object, ctx as object, section as string, force as boolean, maxWaitMs = catalog.SHARED_WAIT_MS as integer) as object
        field = "catalogLoad_" + section
        if m.global = invalid or not m.global.hasField(field) then return catalog.loadSection(transport, ctx, section, force)
        token = CreateObject("roDeviceInfo").GetRandomUUID()
        waited = false
        seen = m.global.getField(field)
        clock = CreateObject("roTimespan")
        while true
            current = m.global.getField(field)
            if current <> seen then
                seen = current
                clock.mark()
            end if
            if current = "" or clock.totalMilliseconds() >= maxWaitMs then
                ' Ler e gravar não é atômico entre threads: as duas gravam, a última vence, e só quem relê a própria
                ' ficha baixa. As gravações passam pela render thread em fila, então a pausa basta para a outra chegar.
                m.global.setField(field, token)
                sleep(catalog.CLAIM_SETTLE_MS)
                if m.global.getField(field) = token then exit while
                seen = m.global.getField(field)
                clock.mark()
            end if
            waited = true
            sleep(200)
        end while
        ' Quem esperou não força: a lista acabou de ser baixada pela outra carga.
        result = catalog.loadSection(transport, ctx, section, force and not waited)
        ' Só libera se ainda for a dona (quem tomou a vez por prazo libera a própria).
        if m.global.getField(field) = token then m.global.setField(field, "")
        return result
    end function

    function loadSection(transport as object, ctx as object, section as string, force as boolean) as object
        meta = invalid
        if not force then meta = catalog.getMeta(ctx.dir, section)
        if meta = invalid then
            if ctx.type = "m3u" then
                err = catalog.importM3u(transport, ctx)
                if err <> invalid then return catalog.loadFailure(err, section)
            else
                names = catalog.actions(section)
                cats = catalog.requestList(transport, ctx, names.categories)
                if cats.error <> invalid then return catalog.loadFailure(cats.error, section)
                streams = catalog.requestList(transport, ctx, names.streams)
                if streams.error <> invalid then return catalog.loadFailure(streams.error, section)
                list = streams.list
                if section = "series" then list = catalog.remapSeries(list)
                catalog.saveSection(ctx.dir, section, cats.list, list)
            end if
        end if
        return { ok: true, error: "", errorDetail: "", list: catalog.publishList(ctx.dir, section) }
    end function

end namespace
