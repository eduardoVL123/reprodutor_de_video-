import "pkg:/source/utils/types.bs"
' Regras das abas TV ao vivo, Filmes e Séries, port de src/components/CatalogBrowser.vue (casos em
' tests/catalogBrowser.test.js e catalogTab.spec.bs). A CatalogTab só desenha o que sai daqui.
namespace catalogTab

    ' Selo NOVO: só com a data do servidor (filme: added; série: last_modified, último episódio), 7 dias.
    const NEW_FOR_DAYS = 7

    function title(section as string) as string
        if section = "live" then return "TV ao vivo"
        if section = "vod" then return "Filmes"
        return "Séries"
    end function

    ' Grade da categoria escolhida (layout do web na TV): pôsteres 5 × 24rem, canais 3 × 10rem, gap 1.25rem,
    ' dentro da área de conteúdo de 1624×893 com respiro de 1rem.
    function gridLayout(section as string) as object
        if section = "live" then return { columns: 3, rowHeight: 160, gap: 20, pad: 16, width: 1624, height: 893, variant: "channel" }
        return { columns: 5, rowHeight: 384, gap: 20, pad: 16, width: 1624, height: 893, variant: "poster" }
    end function

    ' Categorias com fileira em "Todos": até 12, sem "Todos" e sem as bloqueadas (locked = { id: true }).
    function rowCategories(categories as object, locked as object) as object
        rows = []
        for each cat in categories
            if rows.count() >= 12 then exit for
            id = utils.textOr(cat.category_id, "")
            if id <> "all" and locked[id] <> true then rows.push(cat)
        end for
        return rows
    end function

    function newBadge(section as string, item as object, nowSecs as integer) as string
        if section = "live" then return ""
        raw = item.added
        if section = "series" then raw = item.last_modified
        secs = Val(utils.textOr(raw, "0"))
        if secs <= 0 or nowSecs - secs >= catalogTab.NEW_FOR_DAYS * 86400 then return ""
        if section = "vod" then return "NOVO"
        return "NOVO EP"
    end function

    ' Aba vazia: séries de lista M3U explicam por quê; o resto diz que a categoria não tem itens.
    function emptyMessage(section as string, sessionType as string, categoryId as string) as object
        if section = "series" and sessionType = "m3u" and categoryId = "all" then
            return { title: "Esta lista não tem séries.", detail: "Listas no formato M3U trazem canais e filmes. As séries aparecem quando o servidor da lista oferece esse catálogo." }
        end if
        return { title: "Nenhum item encontrado nesta categoria.", detail: "" }
    end function

    ' Rolagem lateral de fileira/barra (overflow-x com scroll-px-3): o item focado entra inteiro, rolando só o
    ' necessário, sem passar do começo nem do fim. Posições no conteúdo da faixa.
    function nearestScroll(scrollLeft as integer, itemLeft as integer, itemWidth as integer, viewport as integer, contentWidth as integer, padding as integer) as integer
        goal = scrollLeft
        if itemLeft - padding < scrollLeft then goal = itemLeft - padding
        if itemLeft + itemWidth + padding > scrollLeft + viewport then goal = itemLeft + itemWidth + padding - viewport
        if goal > contentWidth - viewport then goal = contentWidth - viewport
        if goal < 0 then goal = 0
        return goal
    end function

    ' Textos do destaque da aba (featured* do CatalogBrowser.vue).
    function heroTexts(section as string, item as object, info as dynamic) as object
        details = {}
        if utils.isObject(info) then details = info
        name = utils.textOr(details.name, "")
        if name = "" then name = utils.textOr(item.name, "")
        rating = utils.textOr(details.rating, "")
        if rating = "" then rating = utils.textOr(item.rating, "")
        ratingText = ""
        if rating <> "" and Val(rating) <> 0 then ratingText = "Nota " + rating
        year = utils.textOr(details.year, "")
        if year = "" then year = utils.textOr(item.year, "")
        duration = utils.textOr(details.duration, "")
        if duration = "" and section = "series" then duration = "Série"
        if duration = "" then duration = "Filme"
        genre = utils.textOr(details.genre, "")
        if genre = "" then genre = utils.textOr(item.genre, "")
        plot = utils.textOr(details.plot, "")
        if plot = "" or plot = "Sem sinopse disponível." then plot = "Explore os melhores títulos do catálogo diretamente da sua lista conectada."
        badge = "FILME DA SUA LISTA"
        if section = "series" then badge = "SÉRIE DA SUA LISTA"
        return { badge: badge, title: name, rating: ratingText, year: year, duration: duration, genre: genre, synopsis: plot }
    end function

    ' Lista M3U que não coube no disco (meta.truncated: M3U não tem servidor por categoria): diz quantos itens ficaram.
    ' Sem par no web, onde o IndexedDB guarda a lista inteira.
    function truncatedNotice(meta as dynamic) as string
        if not utils.isObject(meta) or meta.truncated <> true then return ""
        return "Esta lista não coube inteira nesta TV: mostrando " + catalogTab.thousands(meta.count) + " de " + catalogTab.thousands(meta.total) + " itens."
    end function

    ' 45210 → "45.210" (pt-BR).
    function thousands(value as dynamic) as string
        digits = Int(value).toStr()
        text = ""
        while Len(digits) > 3
            text = "." + Right(digits, 3) + text
            digits = Left(digits, Len(digits) - 3)
        end while
        return digits + text
    end function

end namespace
