' Casos de tests/catalogDb.test.js, tests/parental.test.js ("catálogo com categorias fora da vista"),
' tests/catalogStore.m3u.test.js e de src/utils/normalizeText.js. Grava em cachefs:/pulse-test-catalog.
namespace tests

    const CATALOG_DIR = "cachefs:/pulse-test-catalog"

    function numberedStreams(n as integer) as object
        list = []
        for i = 1 to n
            list.push({ stream_id: i, name: "Item " + i.toStr(), category_id: ((i - 1) mod 2 + 1).toStr() })
        end for
        return list
    end function

    function ids(items as object) as object
        result = []
        for each item in items
            result.push(item.stream_id)
        end for
        return result
    end function

    ' Filmes 3 e 4 na categoria 2 (escondida nos testes do controle parental).
    function parentalStreams() as object
        return [
            { stream_id: 1, name: "Filme Um", category_id: "1" },
            { stream_id: 2, name: "Filme Dois", category_id: "1" },
            { stream_id: 3, name: "Filme Tres", category_id: "2" },
            { stream_id: 4, name: "Filme Quatro", category_id: "2" },
            { stream_id: 5, name: "Filme Cinco", category_id: "3" },
            { stream_id: 6, name: "Filme Seis", category_id: "3" }
        ]
    end function

    @suite("catalog")
    class CatalogTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            catalog.clearCatalog(tests.CATALOG_DIR)
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("normalizeText — forma canônica para busca")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("minúsculas, sem acentos, pontuação vira espaço")
        @params("Homem-Aranha: Longe de Casa", "homem aranha longe de casa")
        @params("AÇÃO e Comédia", "acao e comedia")
        @params("  ★ Série  │ Ñandú ", "serie nandu")
        @params("Ωmega Жар 東京", "ωmega жар 東京")
        function _(text, expected)
            m.assertEqual(catalog.normalizeText(text), expected)
        end function

        @it("foldText tira acento e põe em minúsculas sem mexer na pontuação")
        function _()
            m.assertEqual(catalog.foldText("Ação: É Já!"), "acao: e ja!")
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("gravação e leitura em janelas")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("lê janelas de itens por categoria e conta corretamente")
        function _()
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], tests.numberedStreams(1200))
            m.assertEqual(catalog.getMeta(tests.CATALOG_DIR, "vod").count, 1200)
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", catalog.ALL_CATEGORIES, 498, 4, [])), [499, 500, 501, 502])
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", "1", 0, 3, [])), [1, 3, 5])
        end function

        @it("item em várias categorias (category_ids dos painéis novos) aparece em todas elas")
        function _()
            multi = [
                { stream_id: 1, name: "Ação e Comédia", category_id: "10", category_ids: [10, 20] },
                { stream_id: 2, name: "Só Comédia", category_id: "20", category_ids: [20] },
                { stream_id: 3, name: "Lançamento", category_id: "10", category_ids: [10, 30] },
                { stream_id: 4, name: "Antigo", category_id: "10" }
            ]
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], multi)
            meta = catalog.getMeta(tests.CATALOG_DIR, "vod")
            m.assertEqual(meta.count, 4)
            m.assertEqual(meta.counts["10"], 3)
            m.assertEqual(meta.counts["20"], 2)
            m.assertEqual(meta.counts["30"], 1)
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", "20", 0, 10, [])), [1, 2])
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", "30", 0, 10, [])), [3])
        end function

        @it("normaliza o item como o web: série usa series_id, capa em stream_icon, extensão mp4")
        function _()
            catalog.saveSection(tests.CATALOG_DIR, "series", [], [{ series_id: 77, name: "Série", cover: "http://i.test/c.jpg", category_id: "5" }])
            item = catalog.getItems(tests.CATALOG_DIR, "series", "5", 0, 1, [])[0]
            m.assertEqual(item.stream_id, 77)
            m.assertEqual(item.stream_icon, "http://i.test/c.jpg")
            m.assertEqual(item.container_extension, "mp4")
            m.assertEqual(item.section, "series")
        end function

        @it("descarta catálogo salvo por versão anterior do app, forçando novo download")
        function _()
            CreateDirectory(tests.CATALOG_DIR)
            CreateDirectory(tests.CATALOG_DIR + "/vod")
            WriteAsciiFile(tests.CATALOG_DIR + "/vod/meta.json", FormatJson({ count: 1, chunkSize: 500, chunkCount: 1, counts: { "1": 1 } }))
            m.assertInvalid(catalog.getMeta(tests.CATALOG_DIR, "vod"))
        end function

        @it("clearCatalog remove tudo")
        function _()
            catalog.saveSection(tests.CATALOG_DIR, "live", [], tests.numberedStreams(3))
            catalog.clearCatalog(tests.CATALOG_DIR)
            m.assertInvalid(catalog.getMeta(tests.CATALOG_DIR, "live"))
            m.assertEqual(catalog.getItems(tests.CATALOG_DIR, "live", catalog.ALL_CATEGORIES, 0, 10, []).count(), 0)
        end function

        @it("índice de busca guarda o nome normalizado na posição do item")
        function _()
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], [{ stream_id: 9, name: "Homem-Aranha", category_id: "1" }])
            m.assertEqual(catalog.getSearchIndex(tests.CATALOG_DIR, "vod"), ["homem aranha"])
        end function

        @it("grava sem os campos que o app nunca lê (o catálogo de 50 mil canais não cabia no disco)")
        function _()
            raw = { num: 7, name: "Canal 7", stream_type: "live", stream_id: 70, stream_icon: "http://i.test/7.png", epg_channel_id: "c7", added: "1700000000", category_id: "2", custom_sid: "", tv_archive: 0, direct_source: "", tv_archive_duration: 0 }
            catalog.saveSection(tests.CATALOG_DIR, "live", [], [raw])
            item = catalog.getItems(tests.CATALOG_DIR, "live", catalog.ALL_CATEGORIES, 0, 1, [])[0]
            m.assertEqual(item, { num: 7, name: "Canal 7", stream_id: 70, series_id: 70, stream_icon: "http://i.test/7.png", added: "1700000000", category_id: "2", container_extension: "", section: "live" })
            ' direct_source com link continua (é o fallback do player).
            raw.direct_source = "http://cdn.test/7.m3u8"
            catalog.saveSection(tests.CATALOG_DIR, "live", [], [raw])
            m.assertEqual(catalog.getItems(tests.CATALOG_DIR, "live", catalog.ALL_CATEGORIES, 0, 1, [])[0].direct_source, "http://cdn.test/7.m3u8")
        end function

        @it("formato compacto: campos extras, ausentes e capa sem barra voltam exatamente como eram")
        function _()
            raw = { stream_id: 5, name: "Série", cover: "http://img.test/a/5.jpg", plot: "Sinopse", category_id: "3", category_ids: ["3", "4"], rating: "8" }
            catalog.saveSection(tests.CATALOG_DIR, "series", [], [raw, { stream_id: 6, name: "Sem capa", stream_icon: "capa.jpg", category_id: "3" }])
            items = catalog.getItems(tests.CATALOG_DIR, "series", catalog.ALL_CATEGORIES, 0, 2, [])
            m.assertEqual(items[0], { stream_id: 5, series_id: 5, name: "Série", cover: "http://img.test/a/5.jpg", stream_icon: "http://img.test/a/5.jpg", plot: "Sinopse", category_id: "3", category_ids: ["3", "4"], rating: "8", container_extension: "mp4", section: "series" })
            m.assertEqual(items[1].stream_icon, "capa.jpg")
            m.assertInvalid(items[1].rating)
        end function

        @it("item real de painel (nulls, campos extras, capa vazia) grava e volta")
        function _()
            raw = ParseJson("[{""num"":1,""name"":""Teste de Conexão ⁺"",""stream_type"":""live"",""stream_id"":9999999,""stream_icon"":"""",""epg_channel_id"":null,""added"":"""",""is_adult"":""0"",""category_id"":""1264"",""custom_sid"":null,""tv_archive"":0,""direct_source"":"""",""tv_archive_duration"":null}]")
            catalog.saveSection(tests.CATALOG_DIR, "live", [{ category_id: "1264", category_name: "TESTE" }], raw)
            meta = catalog.getMeta(tests.CATALOG_DIR, "live")
            m.assertNotInvalid(meta)
            m.assertEqual(meta.count, 1)
            item = catalog.getItems(tests.CATALOG_DIR, "live", catalog.ALL_CATEGORIES, 0, 1, [])[0]
            m.assertEqual(item.name, "Teste de Conexão ⁺")
            m.assertEqual(item.is_adult, "0")
            ' Arquivos só em ASCII (o WriteAsciiFile do simulador falhava com "–", "’", "⁺"); o nome volta igual.
            catalog.saveSection(tests.CATALOG_DIR, "vod", [{ category_id: "1", category_name: "Ação – Clássicos’" }], [{ stream_id: 1, name: "Filme – O Começo’s ⁺", category_id: "1" }])
            for each file in ["chunk-0.json", "categories.json", "search.json"]
                text = ReadAsciiFile(tests.CATALOG_DIR + "/vod/" + file)
                ascii = true
                for i = 1 to Len(text)
                    if Asc(Mid(text, i, 1)) > 127 then ascii = false
                end for
                m.assertTrue(ascii, file)
            end for
            m.assertEqual(catalog.getItems(tests.CATALOG_DIR, "vod", catalog.ALL_CATEGORIES, 0, 1, [])[0].name, "Filme – O Começo’s ⁺")
            m.assertEqual(catalog.getCategories(tests.CATALOG_DIR, "vod")[0].category_name, "Ação – Clássicos’")
        end function

        @it("o chunk compacto ocupa bem menos que o item inteiro em JSON")
        function _()
            streams = []
            for i = 1 to 500
                streams.push({ num: i, name: "Canal " + i.toStr(), stream_id: i, stream_icon: "http://painel.exemplo.com:8080/images/logos/canal" + i.toStr() + ".png", added: "1700000000", category_id: "1" })
            end for
            catalog.saveSection(tests.CATALOG_DIR, "live", [], streams)
            compact = Len(ReadAsciiFile(tests.CATALOG_DIR + "/live/chunk-0.json"))
            full = Len(FormatJson(catalog.getItems(tests.CATALOG_DIR, "live", catalog.ALL_CATEGORIES, 0, 500, [])))
            m.assertTrue(compact < full * 0.6, compact.toStr() + " de " + full.toStr())
        end function

        @it("lista Xtream que não cabe no disco passa a vir do servidor, sem cortar nada")
        function _()
            streams = tests.numberedStreams(1200)
            catalog.saveSection(tests.CATALOG_DIR, "vod", [{ category_id: "2", category_name: "B" }, { category_id: "1", category_name: "A" }], streams, 10)
            meta = catalog.getMeta(tests.CATALOG_DIR, "vod")
            m.assertTrue(catalog.isRemote(meta))
            m.assertEqual(meta.count, 1200)
            m.assertEqual(meta.order, ["2", "1"])
            list = catalog.publishList(tests.CATALOG_DIR, "vod")
            m.assertEqual(list[0].count, 1200)
            m.assertEqual(list[1].count, 600)
            m.assertEqual(catalog.visibleCount(tests.CATALOG_DIR, "vod", ["2"]), 600)
            m.assertEqual(catalog.getSearchIndex(tests.CATALOG_DIR, "vod").count(), 0)
        end function

        @it("pelo servidor: a página baixa só as categorias que toca, na ordem, sem as fora da vista, e guarda em tmp:")
        function _()
            catalog.deleteTree("tmp:/pulse-remote")
            streams = tests.numberedStreams(6)
            catalog.saveSection(tests.CATALOG_DIR, "vod", [{ category_id: "1", category_name: "A" }, { category_id: "2", category_name: "B" }], streams, 10)
            meta = catalog.getMeta(tests.CATALOG_DIR, "vod")
            base = "http://srv.test/player_api.php?username=u&password=p&action=get_vod_streams&category_id="
            t = tests.fakeTransport([
                { prefix: base + "1", response: tests.jsonResponse([{ stream_id: 1, name: "Um", category_id: "1" }, { stream_id: 3, name: "Três", category_id: "1" }, { stream_id: 5, name: "Cinco", category_id: "1" }]) },
                { prefix: base + "2", response: tests.jsonResponse([{ stream_id: 2, name: "Dois", category_id: "2" }, { stream_id: 4, name: "Quatro", category_id: "2" }, { stream_id: 6, name: "Seis", category_id: "2" }]) }
            ])
            ctx = { dir: tests.CATALOG_DIR, apiBase: "http://srv.test", credentials: { username: "u", password: "p" } }
            m.assertEqual(tests.ids(catalog.remoteItems(t, ctx, "vod", catalog.ALL_CATEGORIES, 2, 3, [], meta)), [5, 2, 4])
            m.assertEqual(t.calls.count(), 2)
            m.assertEqual(tests.ids(catalog.remoteItems(t, ctx, "vod", "2", 1, 10, [], meta)), [4, 6])
            m.assertEqual(t.calls.count(), 2)
            m.assertEqual(tests.ids(catalog.remoteItems(t, ctx, "vod", catalog.ALL_CATEGORIES, 0, 10, ["1"], meta)), [2, 4, 6])
            m.assertEqual(catalog.remoteItems(t, ctx, "vod", "1", 0, 10, ["1"], meta).count(), 0)
            item = catalog.remoteItems(t, ctx, "vod", "1", 0, 1, [], meta)[0]
            m.assertEqual(item.section, "vod")
            m.assertEqual(item.container_extension, "mp4")
            catalog.deleteTree("tmp:/pulse-remote")
        end function

        @it("pelo servidor com espaço para a busca: o índice leve cobre a lista toda")
        function _()
            streams = tests.numberedStreams(1200)
            ' Capas longas como as das listas reais: o item completo pesa bem mais que o leve.
            for each it in streams
                it.stream_icon = "http://img" + it.stream_id.toStr() + ".exemplo.com/" + String(150, "x") + ".jpg"
            end for
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], streams)
            oneChunk = Len(ReadAsciiFile(tests.CATALOG_DIR + "/vod/chunk-0.json"))
            ' Cabe a busca leve inteira, mas não os itens completos.
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], streams, oneChunk * 2)
            meta = catalog.getMeta(tests.CATALOG_DIR, "vod")
            m.assertTrue(catalog.isRemote(meta))
            m.assertEqual(meta.searchCount, 1200)
            m.assertEqual(catalog.getSearchIndex(tests.CATALOG_DIR, "vod")[1199], "item 1200")
            found = catalog.getItemsAt(tests.CATALOG_DIR, "vod", [1199])[0]
            m.assertEqual(found.stream_id, 1200)
            m.assertEqual(found.name, "Item 1200")
        end function

        @it("M3U sem espaço para tudo (sem servidor por categoria): guarda os primeiros itens que couberem")
        function _()
            streams = tests.numberedStreams(1200)
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], streams)
            oneChunk = Len(ReadAsciiFile(tests.CATALOG_DIR + "/vod/chunk-0.json"))
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], streams, oneChunk + 600 * catalog.INDEX_BYTES_PER_ITEM, false)
            meta = catalog.getMeta(tests.CATALOG_DIR, "vod")
            m.assertNotInvalid(meta)
            m.assertTrue(meta.truncated)
            m.assertEqual(meta.count, 500)
            m.assertEqual(meta.total, 1200)
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", catalog.ALL_CATEGORIES, 498, 10, [])), [499, 500])
            m.assertEqual(catalog.publishList(tests.CATALOG_DIR, "vod")[0].count, 500)
            m.assertEqual(catalog.getSearchIndex(tests.CATALOG_DIR, "vod").count(), 500)
            ' Nem um chunk cabe: a seção fica vazia mas com o resumo (não baixa de novo em laço).
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], streams, 10, false)
            m.assertEqual(catalog.getMeta(tests.CATALOG_DIR, "vod").count, 0)
        end function

        @it("só a lista ativa fica no disco: o Início apaga o catálogo das outras listas ao começar")
        function _()
            a = catalog.DEFAULT_DIR + "/pulse-test-a"
            b = catalog.DEFAULT_DIR + "/pulse-test-b"
            catalog.saveSection(a, "live", [], tests.numberedStreams(3))
            m.assertNotInvalid(catalog.getMeta(a, "live"))
            catalog.saveSection(b, "live", [], tests.numberedStreams(3))
            ' Gravar não apaga a outra lista (uma Task antiga ainda gravando não perde a pasta); o Início limpa ao começar.
            m.assertNotInvalid(catalog.getMeta(a, "live"))
            catalog.pruneOtherLists(b)
            m.assertInvalid(catalog.getMeta(a, "live"))
            m.assertFalse(CreateObject("roFileSystem").exists(a))
            m.assertNotInvalid(catalog.getMeta(b, "live"))
            catalog.deleteTree(b)
        end function

        @it("índice de busca que não coube no disco é refeito pelos chunks (buildSearchIndex)")
        function _()
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], tests.numberedStreams(1200))
            DeleteFile(tests.CATALOG_DIR + "/vod/search.json")
            names = catalog.getSearchIndex(tests.CATALOG_DIR, "vod")
            m.assertEqual(names.count(), 1200)
            m.assertEqual(names[0], "item 1")
            m.assertEqual(names[1199], "item 1200")
        end function

        @it("índice de busca com tamanho diferente do resumo também é refeito")
        function _()
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], tests.numberedStreams(3))
            WriteAsciiFile(tests.CATALOG_DIR + "/vod/search.json", FormatJson(["item 1"]))
            m.assertEqual(catalog.getSearchIndex(tests.CATALOG_DIR, "vod"), ["item 1", "item 2", "item 3"])
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("categorias fora da vista (controle parental)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("'Todos' e a contagem deixam de fora as categorias escondidas/bloqueadas")
        function _()
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], tests.parentalStreams())
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", catalog.ALL_CATEGORIES, 0, 10, ["2"])), [1, 2, 5, 6])
            m.assertEqual(catalog.visibleCount(tests.CATALOG_DIR, "vod", ["2"]), 4)
            m.assertInvalid(catalog.visibleCount(tests.CATALOG_DIR, "vod", []))
            m.assertEqual(catalog.getItems(tests.CATALOG_DIR, "vod", catalog.ALL_CATEGORIES, 0, 10, []).count(), 6)
        end function

        @it("item em duas categorias: bloqueado em uma, some também da outra (itens e contagem)")
        function _()
            streams = [{ stream_id: 1, name: "Ação comum", category_id: "1" }, { stream_id: 2, name: "Duplo", category_id: "1", category_ids: ["1", "9"] }]
            catalog.saveSection(tests.CATALOG_DIR, "vod", [], streams)
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", "1", 0, 10, ["9"])), [1])
            m.assertEqual(catalog.visibleCategoryCounts(tests.CATALOG_DIR, "vod", ["9"])["1"], 1)
            m.assertEqual(tests.ids(catalog.getItems(tests.CATALOG_DIR, "vod", "1", 0, 10, [])), [1, 2])
            m.assertInvalid(catalog.visibleCategoryCounts(tests.CATALOG_DIR, "vod", []))
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("lista de categorias publicada")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("começa por 'Todos' e só traz categorias com itens")
        function _()
            cats = [{ category_id: 1, category_name: "Ação" }, { category_id: 2, category_name: "Vazia" }, { category_id: 3, category_name: "Drama" }]
            catalog.saveSection(tests.CATALOG_DIR, "vod", cats, [{ stream_id: 1, name: "A", category_id: "1" }, { stream_id: 2, name: "B", category_id: "3" }])
            list = catalog.publishList(tests.CATALOG_DIR, "vod")
            m.assertEqual(list.count(), 3)
            m.assertEqual(list[0].category_name, "Todos")
            m.assertEqual(list[0].count, 2)
            m.assertEqual(list[1].category_id, "1")
            m.assertEqual(list[2].category_name, "Drama")
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("carga da seção (catalogStore)")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("cada lista tem a sua pasta: trocar de lista não reaproveita o catálogo da outra")
        function _()
            a = catalog.contextFor({ id: "list_a", type: "xtream", baseUrl: "http://a.test", resolvedUrl: "http://a2.test", username: "u", password: "p" })
            b = catalog.contextFor({ id: "list_b", type: "m3u", baseUrl: "http://b.test", resolvedUrl: "", username: "M3U Playlist", password: "" })
            m.assertNotEqual(a.dir, b.dir)
            m.assertTrue(a.dir.startsWith(catalog.DEFAULT_DIR + "/"))
            m.assertEqual(a.apiBase, "http://a2.test")
            m.assertEqual(b.apiBase, "http://b.test")
            m.assertEqual(a.credentials, { username: "u", password: "p" })
            m.assertEqual(b.type, "m3u")
        end function

        @it("grava a pasta da lista mesmo sem a pasta-mãe (cachefs vazio depois do reboot)")
        function _()
            parent = tests.CATALOG_DIR + "-parent"
            catalog.deleteTree(parent)
            dir = parent + "/lista"
            catalog.saveSection(dir, "vod", [], tests.numberedStreams(3))
            m.assertEqual(tests.ids(catalog.getItems(dir, "vod", catalog.ALL_CATEGORIES, 0, 10, [])), [1, 2, 3])
            catalog.deleteTree(parent)
        end function

        @it("Xtream: baixa categorias e itens, grava e não baixa de novo se já houver cache")
        function _()
            base = "http://srv.test"
            t = tests.fakeTransport([
                { prefix: base + "/player_api.php?username=u&password=p&action=get_vod_categories", response: tests.jsonResponse([{ category_id: "1", category_name: "Ação" }]) },
                { prefix: base + "/player_api.php?username=u&password=p&action=get_vod_streams", response: tests.jsonResponse(tests.numberedStreams(3)) }
            ])
            ctx = { dir: tests.CATALOG_DIR, apiBase: base, credentials: { username: "u", password: "p" }, type: "xtream" }
            result = catalog.loadSection(t, ctx, "vod", false)
            m.assertTrue(result.ok)
            m.assertEqual(result.list[0].count, 3)
            m.assertEqual(t.calls.count(), 2)
            catalog.loadSection(t, ctx, "vod", false)
            m.assertEqual(t.calls.count(), 2)
        end function

        @it("loadShared: dona que sumiu perde a vez pelo prazo; baixa uma vez e libera a seção")
        function _()
            if not m.global.hasField("catalogLoad_vod") then m.global.addFields({ catalogLoad_vod: "" })
            m.global.setField("catalogLoad_vod", "task-morta")
            base = "http://srv.test"
            t = tests.fakeTransport([
                { prefix: base + "/player_api.php?username=u&password=p&action=get_vod_categories", response: tests.jsonResponse([{ category_id: "1", category_name: "Ação" }]) },
                { prefix: base + "/player_api.php?username=u&password=p&action=get_vod_streams", response: tests.jsonResponse(tests.numberedStreams(2)) }
            ])
            ctx = { dir: tests.CATALOG_DIR, apiBase: base, credentials: { username: "u", password: "p" }, type: "xtream" }
            result = catalog.loadShared(t, ctx, "vod", false, 400)
            m.assertTrue(result.ok)
            m.assertEqual(t.calls.count(), 2)
            m.assertEqual(m.global.getField("catalogLoad_vod"), "")
        end function

        @it("Xtream: painel que devolve false para lista vazia vira seção vazia, sem erro")
        function _()
            t = tests.fakeTransport([{ prefix: "http://srv.test", response: tests.jsonResponse(false) }])
            result = catalog.loadSection(t, { dir: tests.CATALOG_DIR, apiBase: "http://srv.test", credentials: { username: "u", password: "p" }, type: "xtream" }, "live", false)
            m.assertTrue(result.ok)
            m.assertEqual(result.list[0].count, 0)
        end function

        @it("Xtream: erro do servidor vira a mensagem do web")
        function _()
            t = tests.fakeTransport([{ prefix: "http://srv.test", response: tests.jsonResponse({}, 503) }])
            result = catalog.loadSection(t, { dir: tests.CATALOG_DIR, apiBase: "http://srv.test", credentials: { username: "u", password: "p" }, type: "xtream" }, "vod", false)
            m.assertFalse(result.ok)
            m.assertEqual(result.error, "O servidor da lista está com problema (erro 503). Tente de novo em alguns minutos.")
        end function

        @it("M3U: uma leitura grava as três seções; Séries fica vazia sem erro")
        function _()
            m3uText = "#EXTM3U" + Chr(10) + "#EXTINF:-1 group-title=" + Chr(34) + "Canais" + Chr(34) + ",Canal A" + Chr(10) + "http://srv.test/live/a.m3u8" + Chr(10) + "#EXTINF:-1 group-title=" + Chr(34) + "Canais" + Chr(34) + ",Canal B" + Chr(10) + "http://srv.test/live/b.m3u8" + Chr(10) + "#EXTINF:-1 group-title=" + Chr(34) + "Filmes" + Chr(34) + ",Filme A" + Chr(10) + "http://srv.test/movie/a.mp4" + Chr(10)
            t = tests.fakeTransport([{ prefix: "http://srv.test/lista.m3u", response: tests.textResponse(m3uText) }])
            ctx = { dir: tests.CATALOG_DIR, apiBase: "http://srv.test/lista.m3u", credentials: { username: "M3U Playlist", password: "" }, type: "m3u" }
            m.assertTrue(catalog.loadSection(t, ctx, "series", false).ok)
            m.assertEqual(catalog.getMeta(tests.CATALOG_DIR, "series").count, 0)
            m.assertEqual(catalog.getMeta(tests.CATALOG_DIR, "live").count, 2)
            m.assertEqual(catalog.getMeta(tests.CATALOG_DIR, "vod").count, 1)
            catalog.loadSection(t, ctx, "live", false)
            catalog.loadSection(t, ctx, "vod", false)
            m.assertEqual(t.calls.count(), 1)
        end function

    end class

end namespace
