' Casos de tests/authStore.test.js (login, senha/URL em repouso, reabrir) e tests/login.test.js (atalhos do link).
' Usa o transporte falso de roku/source/xtream/api.spec.bs.
namespace tests

    const SERVER = "http://srv.test:8080"
    const TOKEN_URL = "http://m3u.test/lista/TOKEN-SECRETO/playlist.m3u"

    function okLoginAt(base as string) as object
        return [{ prefix: base, response: tests.jsonResponse({ user_info: { auth: 1, status: "Active" }, server_info: {} }) }]
    end function

    function playlist() as string
        return "#EXTM3U" + Chr(10) + "#EXTINF:-1 group-title=" + Chr(34) + "Canais" + Chr(34) + ",Canal 1" + Chr(10) + "http://m3u.test/live/1.m3u8" + Chr(10)
    end function

    @suite("session")
    class SessionTests extends rooibos.BaseTestSuite

        protected override function beforeEach()
            m.store = storage.create("pulse-test")
            m.store.clear()
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("applySnippet — atalhos de digitação do link")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("acrescenta no fim e põe o protocolo no começo sem duplicar")
        function _()
            m.assertEqual(session.applySnippet("meuservidor", ".com"), "meuservidor.com")
            m.assertEqual(session.applySnippet("meuservidor.com", ":8080"), "meuservidor.com:8080")
            m.assertEqual(session.applySnippet("meuservidor.com", "http://"), "http://meuservidor.com")
            m.assertEqual(session.applySnippet("https://meuservidor.com", "http://"), "http://meuservidor.com")
            m.assertEqual(session.applySnippet("", "www."), "www.")
        end function

        @it("os atalhos são os mesmos do app web")
        function _()
            m.assertEqual(session.urlSnippets(), ["http://", "https://", "www.", ".com", ".net", ":8080", "/"])
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("login Xtream — senha em repouso")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("entra, salva a lista e a sessão sem a senha em texto puro")
        function _()
            t = tests.fakeTransport(tests.okLoginAt(tests.SERVER))
            result = session.login(t, m.store, { dns: tests.SERVER, username: "user1", password: "senha-secreta" })
            m.assertTrue(result.ok)
            lists = m.store.get(session.SAVED_LISTS_KEY)
            m.assertEqual(lists.count(), 1)
            m.assertTrue(FormatJson(lists).instr("senha-secreta") < 0)
            m.assertNotInvalid(lists[0].passwordEnc)
            saved = m.store.get(session.SESSION_KEY)
            m.assertTrue(FormatJson(saved).instr("senha-secreta") < 0)
            m.assertEqual(result.session.password, "senha-secreta") ' em memória a sessão usa a senha real
        end function

        @it("id e rótulo da lista como no web")
        function _()
            t = tests.fakeTransport(tests.okLoginAt(tests.SERVER))
            result = session.login(t, m.store, { dns: tests.SERVER, username: " user1 ", password: "p" })
            m.assertEqual(result.session.id, "list_http___srv_test_8080_user1")
            m.assertEqual(result.session.label, "user1 @ srv.test")
            m.assertEqual(result.session.type, "xtream")
        end function

        @it("entrar de novo na mesma conta não duplica a lista")
        function _()
            t = tests.fakeTransport(tests.okLoginAt(tests.SERVER))
            session.login(t, m.store, { dns: tests.SERVER, username: "user1", password: "p" })
            session.login(t, m.store, { dns: tests.SERVER, username: "user1", password: "p" })
            m.assertEqual(m.store.get(session.SAVED_LISTS_KEY).count(), 1)
        end function

        @it("reabrir o app decifra a senha da sessão")
        function _()
            t = tests.fakeTransport(tests.okLoginAt(tests.SERVER))
            session.login(t, m.store, { dns: tests.SERVER, username: "user1", password: "senha-secreta" })
            restored = session.hydrate(storage.create("pulse-test"))
            m.assertEqual(restored.password, "senha-secreta")
            m.assertEqual(restored.username, "user1")
        end function

        @it("sessão com dado adulterado exige novo login")
        function _()
            m.store.set(session.SESSION_KEY, { type: "xtream", baseUrl: tests.SERVER, username: "u", passwordEnc: { v: 1, data: "00ff" } })
            m.assertInvalid(session.hydrate(m.store))
            m.assertInvalid(m.store.get(session.SESSION_KEY))
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("login — erros")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("link sem lista nem credenciais pede usuário e senha com a mensagem do web")
        function _()
            t = tests.fakeTransport([{ prefix: "http://srv.test", response: tests.textResponse("<html></html>") }])
            result = session.login(t, m.store, { dns: "http://srv.test/curto", username: "", password: "" })
            m.assertFalse(result.ok)
            m.assertEqual(result.error, "Este link exige Usuário e Senha. Preencha os campos abaixo.")
            m.assertTrue(result.errorDetail.instr("[MISSING_CREDENTIALS]") >= 0)
        end function

        @it("senha recusada mostra a mensagem e não salva nada")
        function _()
            t = tests.fakeTransport([{ prefix: tests.SERVER, response: tests.jsonResponse({ user_info: { auth: 0 } }) }])
            result = session.login(t, m.store, { dns: tests.SERVER, username: "u", password: "errada" })
            m.assertEqual(result.error, "Usuário ou senha incorretos recusados pelo servidor.")
            m.assertInvalid(m.store.get(session.SESSION_KEY))
            m.assertInvalid(m.store.get(session.SAVED_LISTS_KEY))
        end function

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("listas M3U")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("lista M3U sem nenhum canal é recusada e não fica salva")
        function _()
            t = tests.fakeTransport([{ prefix: "http://m3u.test", response: tests.textResponse("#EXTM3U" + Chr(10)) }])
            result = session.login(t, m.store, { dns: tests.TOKEN_URL })
            m.assertFalse(result.ok)
            m.assertTrue(result.error.instr("não contém nenhum canal") >= 0)
            m.assertInvalid(m.store.get(session.SAVED_LISTS_KEY))
            m.assertInvalid(m.store.get(session.SESSION_KEY))
        end function

        @it("não grava a URL com token em texto puro, nem no id da lista")
        function _()
            t = tests.fakeTransport([{ prefix: "http://m3u.test", response: tests.textResponse(tests.playlist()) }])
            result = session.login(t, m.store, { dns: tests.TOKEN_URL })
            m.assertTrue(result.ok)
            everything = FormatJson([m.store.get(session.SAVED_LISTS_KEY), m.store.get(session.SESSION_KEY)])
            m.assertTrue(everything.instr("TOKEN-SECRETO") < 0)
            m.assertTrue(result.session.id.instr("TOKEN") < 0)
            m.assertEqual(result.session.resolvedUrl, tests.TOKEN_URL) ' em memória a sessão usa a URL real
            m.assertEqual(result.session.label, "Lista M3U @ m3u.test")
        end function

        @it("reabre a sessão M3U decifrando a URL")
        function _()
            t = tests.fakeTransport([{ prefix: "http://m3u.test", response: tests.textResponse(tests.playlist()) }])
            first = session.login(t, m.store, { dns: tests.TOKEN_URL })
            restored = session.hydrate(storage.create("pulse-test"))
            m.assertEqual(restored.resolvedUrl, tests.TOKEN_URL)
            m.assertEqual(restored.id, first.session.id)
        end function

    end class

end namespace
