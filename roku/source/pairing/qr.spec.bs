' Matrizes geradas pelo qrcode-generator (o que o web usa em src/utils/qrSvg.js), correção M e versão automática.
namespace tests

    @suite("qr")
    class QrTests extends rooibos.BaseTestSuite

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("matrix")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("v1: igual ao qrcode-generator")
        function _()
            m.assertEqual(qr.matrix("A"), [
                "111111101101001111111",
                "100000100110001000001",
                "101110100111101011101",
                "101110101110001011101",
                "101110101110101011101",
                "100000101111001000001",
                "111111101010101111111",
                "000000001011100000000",
                "100010111001011111001",
                "001010001001100101011",
                "111101100011001111100",
                "111000010100011010110",
                "111011111000111000111",
                "000000001010111000111",
                "111111101100110000010",
                "100000100111100101010",
                "101110101111001111111",
                "101110100101100101011",
                "101110100001001111100",
                "100000100100011010100",
                "111111101010111000101"
            ])
        end function

        @it("v3: igual ao qrcode-generator")
        function _()
            m.assertEqual(qr.matrix("http://localhost:8788/K7M2QP"), [
                "11111110110100011011001111111",
                "10000010110000001111001000001",
                "10111010111010011000101011101",
                "10111010000110001111101011101",
                "10111010101110111101101011101",
                "10000010011010011000001000001",
                "11111110101010101010101111111",
                "00000000010101011001100000000",
                "10011111100101000000110010111",
                "01011101110011001111100110110",
                "01101110010101011100111110100",
                "10110101000111001100001000001",
                "00111011101001011010001100001",
                "01001101110111101000101111011",
                "11000011100111001111100111101",
                "11010101101000010011010010101",
                "00110011011000101100000100000",
                "11110101010111101101010011110",
                "11000010101000010111111000001",
                "11110100110000100001111011100",
                "11000011000111111000111111110",
                "00000000110000100001100011000",
                "11111110111100100111101011000",
                "10000010101110110110100011001",
                "10111010111001100111111111000",
                "10111010110001000111010000010",
                "10111010010010010101100111011",
                "10000010011101001111011101101",
                "11111110111010010100110000000"
            ])
        end function

        @it("v5, dois blocos: igual ao qrcode-generator")
        function _()
            m.assertEqual(qr.matrix("https://pareamento.exemplo-de-servidor.com.br/caminho/K7M2QP?x=1234567890"), [
                "1111111000110011111100001001001111111",
                "1000001011011111110100101110001000001",
                "1011101010111010001111000000001011101",
                "1011101010010001010101001100101011101",
                "1011101001101100001111010010101011101",
                "1000001000010011001000101000101000001",
                "1111111010101010101010101010101111111",
                "0000000010100110000100101010100000000",
                "1000001010010111001010000011111001110",
                "1100100011000010010011011001100110110",
                "0111001010000000001010100011101011111",
                "0110100011110001100000111000101110001",
                "1111011000001110100100110000101001001",
                "1101000100100101111110010001100101010",
                "1000011111110011110010100001100111011",
                "0011010011110011011000100010001101100",
                "1110101000101010100000010100011010101",
                "0000110110111100001011111110100101110",
                "0100111001011111010011011001011010001",
                "1101000100100100001110111011111011001",
                "0001011111001101010100101101011011100",
                "0111110010010111001100110111010010100",
                "1100111101000111101010100111110111011",
                "1010100101011001000100100010010111000",
                "0010001101101101111110110001011100000",
                "1010000010101000110000111111000100000",
                "1001101100101110010001100111101100111",
                "1000000011100001000010101011100101111",
                "1001001000100110010010101110111111100",
                "0000000011011011110111010100100010000",
                "1111111001001011100101111110101010011",
                "1000001000100011111010001001100010011",
                "1011101000101100100110010101111110110",
                "1011101000111010101110011001111000101",
                "1011101000101011111011100010000000011",
                "1000001000011100001000100010010011001",
                "1111111010011001101010100000100101001"
            ])
        end function

        @it("v6, quatro blocos: igual ao qrcode-generator")
        function _()
            m.assertEqual(qr.matrix("https://pareamento.exemplo-de-servidor.com.br/um/caminho/bem/mais/comprido/para/a/versao/seis/K7M2QP"), [
                "11111110001101110001001101110111001111111",
                "10000010001111100100111111110010101000001",
                "10111010000101011100000110111100101011101",
                "10111010010001000101011001110010001011101",
                "10111010010100101000011110111000001011101",
                "10000010111010101001001001011001001000001",
                "11111110101010101010101010101010101111111",
                "00000000000001100101011000101100000000000",
                "10010110100111000000110111101001110100000",
                "01000101110001010100100000001100111001111",
                "00110110110110000011011000001001000001100",
                "11011100000110010011011111010000011000100",
                "11000110101110000101110101001101111001001",
                "00010101000101001100110111001101000001010",
                "11111010000011010011000111100110101000011",
                "11001001000000001100110001100110101100011",
                "01001111110001000100111010000100100101011",
                "01000000111111101100010110101000001101011",
                "11011010011010001100101011100110011010111",
                "10100100110001000000011000100111101101001",
                "01100110110101110100001101011001011000110",
                "11001101010100011000110011101100101000111",
                "11100011000100101001001011000011110110010",
                "11111101101110000000011101001010000100110",
                "11101010111011011101110011011100111001011",
                "01011000111010010001110011000011010001010",
                "01000111000110101100100110100000101000011",
                "00000100101010010111111111111110101010001",
                "01100010100000101101011000101100110100011",
                "01011101111010110001100100101110011100111",
                "10011110000001100010010000000010000111111",
                "00101100010111100110010110111110010010001",
                "10111111111000111010111001111000111110100",
                "00000000110011011100100011100111100010111",
                "11111110011011101011011010001000101010000",
                "10000010111010001010000001000011100011101",
                "10111010011000110011100010001100111110010",
                "10111010111000111111001011001101011011010",
                "10111010000111000110101111101011100010111",
                "10000010000011101001110011000100110100010",
                "11111110100111101000111100000100101111010"
            ])
        end function

        @it("texto vazio ou maior que a versão 6 não vira QR")
        function _()
            m.assertInvalid(qr.matrix(""))
            m.assertInvalid(qr.matrix(String(107, "a")))
            m.assertEqual(qr.matrix(String(106, "a")).count(), 41)
        end function

    end class

end namespace
