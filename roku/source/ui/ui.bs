' Tipografia e cores do app web (tailwind.config.js) em pixels de 1920×1080 (1rem = 16 px).
' Usado pelos componentes (render thread): cria nós SceneGraph.
namespace ui

    ' Cores (0xRRGGBBAA)
    const TEXT_COLOR = "0xF1F5F9FF" ' tv-text (não chamar de TEXT: o BrighterScript confundiria com ui.text)
    const MUTED = "0x8E8E93FF" ' tv-muted
    const ACCENT = "0xB8F000FF" ' tv-accent
    const ACCENT_SOFT = "0xCCFF33FF" ' tv-accent-soft
    const DEEP = "0x0B0F0CFF" ' tv-deep
    const WHITE = "0xFFFFFFFF"
    const BLACK = "0x000000FF"
    const ERROR = "0xF87171FF" ' text-red-400
    const WARNING = "0xFCD34DFF" ' text-amber-300
    const TEXT_ON_ACCENT = "0x0B0F0CFF" ' tv-on-accent: texto sobre o limão é grafite, nunca branco
    const NEUTRAL_400 = "0xA3A3A3FF"
    const NEUTRAL_500 = "0x737373FF"
    const RED_300 = "0xFCA5A5FF"

    ' Fonte Roboto (a que as outras TVs mostram; roku/fonts/README.md) no peso pedido: 400 Regular, 500 Medium,
    ' 600 SemiBold, 700 Bold.
    function font(weight as integer, size as integer) as object
        name = "Regular"
        if weight >= 900 then
            name = "Black"
        else if weight >= 700 then
            name = "Bold"
        else if weight >= 600 then
            name = "SemiBold"
        else if weight >= 500 then
            name = "Medium"
        end if
        return ui.cachedFont("pkg:/fonts/Roboto-" + name + ".ttf", size)
    end function

    ' Um nó Font por arquivo e tamanho, guardado no m do componente: criar um a cada texto carrega o TTF de novo e
    ' trava a render thread (a Roku fecha o app depois de 10 s travada).
    function cachedFont(uri as string, size as integer) as object
        if m.uiFonts = invalid then m.uiFonts = {}
        key = uri + "@" + size.toStr()
        if m.uiFonts[key] = invalid then
            f = CreateObject("roSGNode", "Font")
            f.uri = uri
            f.size = size
            m.uiFonts[key] = f
        end if
        return m.uiFonts[key]
    end function

    ' Fonte monoespaçada (font-mono do web: os atalhos e a causa técnica do erro), Roboto Mono Medium.
    function monoFont(size as integer) as object
        return ui.cachedFont("pkg:/fonts/RobotoMono-Medium.ttf", size)
    end function

    ' Label com quebra de linha e altura de linha do CSS (line-height). O espaço extra fica metade em cima, metade
    ' embaixo, como o navegador faz. Devolve o Label já posicionado em [x, y] (topo da caixa da linha).
    function text(parent as object, value as string, fontNode as object, color as string, x as float, y as float, width as float, lineHeight as float) as object
        label = parent.createChild("Label")
        label.font = fontNode
        label.color = color
        label.text = value
        label.width = width
        label.wrap = true
        natural = ui.naturalLineHeight(fontNode)
        label.lineSpacing = lineHeight - natural
        label.translation = [x, y + (lineHeight - natural) / 2]
        return label
    end function

    ' Texto de uma linha sem largura fixa, para posicionar o próximo pedaço logo depois: com width fixo o
    ' boundingRect().width devolve o width, não a largura do texto.
    function inlineText(parent as object, value as string, fontNode as object, color as string, x as float, y as float, lineHeight as float) as object
        label = ui.text(parent, value, fontNode, color, x, y, 0, lineHeight)
        label.wrap = false
        return label
    end function

    ' Altura de uma linha da fonte sem espaçamento extra.
    function naturalLineHeight(fontNode as object) as float
        if m.uiLineHeights = invalid then m.uiLineHeights = {}
        key = fontNode.uri + "@" + fontNode.size.toStr()
        if m.uiLineHeights[key] = invalid then
            probe = CreateObject("roSGNode", "Label")
            probe.font = fontNode
            probe.text = "Ág"
            m.uiLineHeights[key] = probe.boundingRect().height
        end if
        return m.uiLineHeights[key]
    end function

    ' Altura ocupada por um texto com quebra (linhas × altura de linha), como o navegador mede.
    function textHeight(label as object, lineHeight as float) as float
        natural = ui.naturalLineHeight(label.font)
        lines = Int((label.boundingRect().height + label.lineSpacing + 0.5) / (natural + label.lineSpacing))
        if lines < 1 then lines = 1
        return lines * lineHeight
    end function

    ' Texto com espaçamento entre letras (tracking do CSS), uma letra por Label.
    function trackedText(parent as object, value as string, fontNode as object, color as string, x as float, y as float, spacing as float) as object
        group = parent.createChild("Group")
        group.translation = [x, y]
        cursor = 0
        for i = 1 to Len(value)
            letter = group.createChild("Label")
            letter.font = fontNode
            letter.color = color
            letter.text = Mid(value, i, 1)
            letter.translation = [cursor, 0]
            cursor = cursor + letter.boundingRect().width + spacing
        end for
        return group
    end function

    ' Retângulo arredondado (imagem 9-patch de roku/images/ui, gerada por npm run roku:ui).
    function panel(parent as object, image as string, x as float, y as float, width as float, height as float) as object
        poster = parent.createChild("Poster")
        poster.uri = "pkg:/images/ui/" + image + ".9.png"
        poster.translation = [x, y]
        poster.width = width
        poster.height = height
        return poster
    end function

    ' Imagem esticada (degradês e máscaras sem 9-patch), de roku/images/ui.
    function panelImage(parent as object, image as string, x as float, y as float, width as float, height as float) as object
        poster = parent.createChild("Poster")
        poster.uri = "pkg:/images/ui/" + image
        poster.translation = [x, y]
        poster.width = width
        poster.height = height
        return poster
    end function

end namespace
