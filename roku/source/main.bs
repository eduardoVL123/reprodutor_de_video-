' Ponto de entrada do app Roku: abre a cena principal e espera ela fechar ou pedir para sair.
sub Main(_args as dynamic)
    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.setMessagePort(port)
    scene = screen.CreateScene("MainScene")
    screen.show()
    scene.observeField("exitApp", port)
    ' Rede do aparelho (NetworkStatus.vue): a cena mostra o aviso enquanto o link estiver fora.
    deviceInfo = CreateObject("roDeviceInfo")
    deviceInfo.setMessagePort(port)
    deviceInfo.enableLinkStatusEvent(true)
    scene.offline = not deviceInfo.getLinkStatus()

    while true
        msg = wait(0, port)
        msgType = type(msg)
        if msgType = "roSGScreenEvent" and msg.isScreenClosed() then return
        if msgType = "roSGNodeEvent" and msg.getField() = "exitApp" and msg.getData() = true then return
        if msgType = "roDeviceInfoEvent" then
            info = msg.getInfo()
            if info <> invalid and GetInterface(info.linkStatus, "ifBoolean") <> invalid then scene.offline = not info.linkStatus
        end if
    end while
end sub
