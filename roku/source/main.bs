' Ponto de entrada do app Roku: abre a cena principal e espera ela fechar ou pedir para sair.
sub Main(args as dynamic)
    screen = CreateObject("roSGScreen")
    port = CreateObject("roMessagePort")
    screen.setMessagePort(port)
    scene = screen.CreateScene("MainScene")
    screen.show()
    scene.observeField("exitApp", port)
    ' Rede do aparelho (NetworkStatus.vue): a cena mostra o aviso enquanto o link estiver fora.
    deviceInfo = CreateObject("roDeviceInfo")
    deviceInfo.setMessagePort(port)
    deviceInfo.enableLinkStatusEvent(true)
    scene.offline = not deviceInfo.getLinkStatus()
    ' Memória (risco de listas grandes em TVs de 512 MB): com o aviso da Roku, solta o cache de categorias (tmp:).
    deviceInfo.enableLowGeneralMemoryEvent(true)
    memory = CreateObject("roAppMemoryMonitor")
    memory.setMessagePort(port)
    memory.enableMemoryWarningEvent(true)
    print "[memória] limite "; FormatJson(memory.getChannelMemoryLimit()); " uso "; memory.getMemoryLimitPercent(); "% livre "; memory.getChannelAvailableMemory()
    ' Deep link: na abertura (args) e com o app aberto (roInput); a cena decide o que abrir (launch.deepLink).
    scene.deepLink = args
    input = CreateObject("roInput")
    input.setMessagePort(port)

    while true
        msg = wait(0, port)
        msgType = type(msg)
        if msgType = "roSGScreenEvent" and msg.isScreenClosed() then return
        if msgType = "roSGNodeEvent" and msg.getField() = "exitApp" and msg.getData() = true then return
        if msgType = "roInputEvent" and msg.isInput() then scene.deepLink = msg.getInfo()
        if msgType = "roAppMemoryNotificationEvent" then freeMemory()
        if msgType = "roDeviceInfoEvent" then
            info = msg.getInfo()
            if info <> invalid and info.generalMemoryLevel <> invalid and info.generalMemoryLevel <> "normal" then freeMemory()
            if info <> invalid and GetInterface(info.linkStatus, "ifBoolean") <> invalid then scene.offline = not info.linkStatus
        end if
    end while
end sub

' Cache das categorias baixadas pelo servidor (catalog.fetchCategory): volta a ser baixado quando a tela pedir.
sub freeMemory()
    for each name in CreateObject("roFileSystem").getDirectoryListing("tmp:/pulse-remote")
        DeleteFile("tmp:/pulse-remote/" + name)
    end for
end sub
