' Mesmos casos de tests/maskSecrets.test.js.
namespace tests

    @suite("net.maskSecrets")
    class MaskSecretsTests extends rooibos.BaseTestSuite

        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
        @describe("maskSecrets")
        '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

        @it("esconde a senha")
        @params("http://h.test/live/joao/segredo/12.m3u8")
        @params("http://h.test:8080/joao/segredo/12")
        @params("http://h.test/get.php?username=joao&password=segredo&type=m3u")
        @params("http://h.test/lista.m3u?token=segredo")
        @params("http://joao:segredo@h.test/lista.m3u")
        function _(url)
            m.assertTrue(net.maskSecrets("Falhou " + url + " agora").instr("segredo") < 0)
        end function

        @it("não mexe em endereço sem credenciais")
        function _()
            m.assertEqual(net.maskSecrets("http://h.test/lista.m3u"), "http://h.test/lista.m3u")
        end function

        @it("invalid vira texto vazio")
        function _()
            m.assertEqual(net.maskSecrets(invalid), "")
        end function

    end class

end namespace
