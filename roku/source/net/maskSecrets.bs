import "pkg:/source/utils/types.bs"
' Port de maskSecrets em src/services/netEnv.js (casos em tests/maskSecrets.test.js).
namespace net

    ' Mascara a senha em URLs/textos antes de exibir ou registrar.
    function maskSecrets(text as dynamic) as string
        if text = invalid then return ""
        result = utils.textOr(text, "")
        result = CreateObject("roRegex", "((?:password|pass|pwd|token)=)[^&\s]*", "i").replaceAll(result, "\1***")
        result = CreateObject("roRegex", "//[^/\s:@]+:[^/\s@]*@", "").replaceAll(result, "//***:***@")
        result = CreateObject("roRegex", "/(live|movie|series)/([^/]+)/([^/]+)/", "i").replaceAll(result, "/\1/\2/***/")
        result = CreateObject("roRegex", "(https?://[^/\s]+)/[^/\s?]+/[^/\s?]+/(\d+)(?=[.?\s]|$)", "i").replaceAll(result, "\1/***/***/\2")
        return result
    end function

end namespace
