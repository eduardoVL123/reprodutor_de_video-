import "pkg:/source/utils/types.bs"
' Papel de src/services/crypto.js (cifra de segredos em repouso: senha do Xtream, URL da lista M3U). O web usa
' AES-GCM 256 com chave não extraível no IndexedDB; a Roku não tem AES-256-GCM, então usa o roDeviceCrypto com a chave
' do app ("channel"), que também nunca fica legível no código. Blob: { v: 1, data: hex }.
namespace secrets

    ' Devolve o blob ou invalid se a cifra não estiver disponível (quem chamou decide o fallback, como no web).
    function encrypt(text as string) as dynamic
        try
            plain = CreateObject("roByteArray")
            plain.fromAsciiString(text)
            encrypted = CreateObject("roDeviceCrypto").encrypt(plain, "channel")
            if encrypted = invalid then return invalid
            return { v: 1, data: LCase(encrypted.toHexString()) }
        catch e
            print "[secrets] Cifra indisponível: "; e.message
            return invalid
        end try
    end function

    ' Devolve o texto ou invalid se a chave sumiu ou o dado foi adulterado.
    function decrypt(blob as dynamic) as dynamic
        if not utils.isObject(blob) or blob.v <> 1 or not utils.isString(blob.data) then return invalid
        try
            encrypted = CreateObject("roByteArray")
            encrypted.fromHexString(blob.data)
            plain = CreateObject("roDeviceCrypto").decrypt(encrypted, "channel")
            if plain = invalid then return invalid
            return plain.toAsciiString()
        catch e
            print "[secrets] Falha ao decifrar segredo: "; e.message
            return invalid
        end try
    end function

end namespace
