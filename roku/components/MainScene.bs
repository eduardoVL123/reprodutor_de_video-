import "pkg:/source/nav/nav.bs"
import "pkg:/source/utils/types.bs"
import "pkg:/source/ftue/ftue.bs"
import "pkg:/source/device/storage.bs"
import "pkg:/source/device/secrets.bs"
import "pkg:/source/xtream/api.bs"
import "pkg:/source/xtream/errors.bs"
import "pkg:/source/xtream/m3uParser.bs"
import "pkg:/source/net/maskSecrets.bs"
import "pkg:/source/session/session.bs"

sub init()
    m.top.backgroundColor = "0x0B0F0CFF"
    m.top.backgroundUri = ""
    m.screens = m.top.findNode("screens")
    pushScreen(CreateObject("roSGNode", initialScreen()))
end sub

' Como a guarda do router do web: sem o aceite dos termos só o FTUE; sem sessão salva, o login; senão a home.
function initialScreen() as string
    store = storage.create()
    if not ftue.isAccepted(store.get(ftue.STORAGE_KEY)) then return "FtueScreen"
    if session.hydrate(store) = invalid then return "LoginScreen"
    return "HomeScreen"
end function

' Abre uma tela por cima da atual; a anterior fica escondida e volta com o Voltar.
sub pushScreen(screen as object)
    current = topScreen()
    if current <> invalid then current.visible = false
    m.screens.appendChild(screen)
    if screen.hasField("navigate") then screen.observeField("navigate", "onNavigate")
    screen.visible = true
    screen.setFocus(true)
end sub

' Troca a tela atual (sem voltar para ela), como o router.replace do web.
sub replaceScreen(screen as object)
    count = m.screens.getChildCount()
    if count > 0 then m.screens.removeChildIndex(count - 1)
    pushScreen(screen)
end sub

sub onNavigate(event as object)
    request = event.getData()
    if request.action = "exit" then
        m.top.exitApp = true
    else if request.action = "replace" then
        replaceScreen(CreateObject("roSGNode", request.screen))
    else if request.action = "push" then
        pushScreen(CreateObject("roSGNode", request.screen))
    end if
end sub

sub popScreen()
    count = m.screens.getChildCount()
    if count <= 1 then return
    m.screens.removeChildIndex(count - 1)
    focusTopScreen()
end sub

function topScreen() as dynamic
    count = m.screens.getChildCount()
    if count = 0 then return invalid
    return m.screens.getChild(count - 1)
end function

sub focusTopScreen()
    current = topScreen()
    if current = invalid then return
    current.visible = true
    current.setFocus(true)
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or key <> "back" then return false
    action = nav.onBack({ stackSize: m.screens.getChildCount(), dialogOpen: m.top.dialog <> invalid })
    if action = "pop" then
        popScreen()
    else if action = "askExit" then
        askExit()
    else if action = "closeDialog" then
        closeDialog()
    end if
    return true
end function

sub askExit()
    dialog = CreateObject("roSGNode", "StandardMessageDialog")
    dialog.title = nav.EXIT_TITLE
    dialog.buttons = nav.exitButtons()
    dialog.observeField("buttonSelected", "onExitButton")
    ' O próprio diálogo fecha com Voltar/Home e avisa em wasClosed.
    dialog.observeField("wasClosed", "onDialogClosed")
    m.top.dialog = dialog
end sub

sub onExitButton(event as object)
    if nav.onExitButton(event.getData()) = "exit" then
        m.top.exitApp = true
    else
        closeDialog()
    end if
end sub

sub closeDialog()
    if m.top.dialog <> invalid then m.top.dialog.close = true
end sub

sub onDialogClosed()
    m.top.dialog = invalid
    focusTopScreen()
end sub
