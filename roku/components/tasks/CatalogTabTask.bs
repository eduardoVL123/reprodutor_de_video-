import "pkg:/source/net/transport.bs"
import "pkg:/source/catalog/catalog.bs"
import "pkg:/source/catalog/catalogTab.bs"
import "pkg:/source/xtream/api.bs"
import "pkg:/source/parental/parental.bs"

sub init()
    m.top.functionName = "runCatalogTab"
end sub

sub runCatalogTab()
    ctx = m.top.ctx
    section = m.top.section
    request = m.top.request
    hidden = m.top.hidden
    if hidden = invalid then hidden = {}
    sectionHidden = hidden[section]
    if sectionHidden = invalid then sectionHidden = []

    if request.mode = "page" then
        items = catalog.getItems(ctx.dir, section, request.categoryId, request.start, request.count, sectionHidden)
        m.top.result = { mode: "page", categoryId: request.categoryId, start: request.start, items: items }
        return
    end if

    transport = net.urlTransport()
    m.ctx = ctx
    m.section = section
    m.openSent = invalid
    m.lastPercent = -1
    loaded = catalog.loadShared(transport, ctx, section, request.force = true, catalog.SHARED_WAIT_MS, { stage: tabStage, progress: tabProgress, provisional: tabProvisional })
    if not loaded.ok then
        m.top.result = { mode: "open", ok: false, error: loaded.error, categories: [], rows: [] }
        return
    end if
    if m.openSent <> invalid then
        ' A aba já abriu pela ficha provisória; agora a gravação acabou: só falta o destaque (ou avisar que terminou).
        heroDetails(transport, ctx, section, m.openSent.heroItem)
        return
    end if
    result = openResult(ctx, section, loaded.list)
    m.top.result = result
    heroDetails(transport, ctx, section, result.heroItem)
end sub

' Etapa da carga (state.step do catalogStore) para a tela de carregamento da aba.
sub tabStage(text as string)
    m.top.result = { mode: "stage", text: text }
end sub

' Barra da gravação: só quando o % inteiro muda (uma lista grande tem centenas de blocos).
sub tabProgress(fraction as float)
    percent = Int(fraction * 100)
    if percent = m.lastPercent then return
    m.lastPercent = percent
    m.top.result = { mode: "progress", percent: percent }
end sub

' A ficha provisória ficou pronta (a aba é quem está gravando): abre já; a gravação segue nesta Task.
sub tabProvisional(section as string)
    m.openSent = openResult(m.ctx, section, catalog.publishList(m.ctx.dir, section))
    m.openSent.early = true
    m.top.result = m.openSent
end sub

' Categorias (com o controle parental), fileiras de "Todos" e o item do destaque.
function openResult(ctx as object, section as string, list as object) as object
    loaded = { list: list }
    choices = m.top.parental
    sectionHidden = []
    ' Controle parental (CatalogBrowser.vue): escondidas somem das categorias; bloqueadas ficam com cadeado e fora das
    ' fileiras; os itens das duas saem de "Todos" e as contagens descontam (item em duas categorias conta uma vez).
    categories = loaded.list
    locked = {}
    if choices <> invalid then
        sectionHidden = parental.blockedIds(choices, section, loaded.list)
        visible = catalog.visibleCategoryCounts(ctx.dir, section, sectionHidden)
        categories = []
        for each cat in loaded.list
            status = parental.statusOf(choices, section, cat)
            if parental.isLocked(choices, section, cat) then locked[cat.category_id] = true
            if status <> "hidden" then
                if cat.category_id = catalog.ALL_CATEGORIES then
                    count = catalog.visibleCount(ctx.dir, section, sectionHidden)
                    if count <> invalid then cat.count = count
                else if visible <> invalid and visible[cat.category_id] <> invalid then
                    cat.count = visible[cat.category_id]
                end if
                categories.push(cat)
            end if
        end for
    end if
    rows = []
    for each cat in catalogTab.rowCategories(categories, locked)
        items = catalog.getItems(ctx.dir, section, cat.category_id, 0, 15, sectionHidden)
        if items.count() > 0 then rows.push({ category_id: cat.category_id, category_name: cat.category_name, items: items })
    end for
    heroItem = invalid
    if section <> "live" and rows.count() > 0 then heroItem = rows[0].items[0]
    notice = catalogTab.truncatedNotice(catalog.getMeta(ctx.dir, section))
    return { mode: "open", ok: true, error: "", categories: categories, rows: rows, heroItem: heroItem, hidden: sectionHidden, allCategories: loaded.list, notice: notice }
end function

sub heroDetails(transport as object, ctx as object, section as string, heroItem as dynamic)
    if heroItem = invalid then
        m.top.result = { mode: "done" }
        return
    end if

    ' Detalhes do destaque (loadFeaturedInfo): série pelo get_series_info, filme pelo get_vod_info.
    info = xtream.normalizeVodInfo(invalid, heroItem)
    if utils.textOr(heroItem.directUrl, "") = "" then
        if section = "series" then
            response = xtream.fetchSeriesInfo(transport, { apiBase: ctx.apiBase, credentials: ctx.credentials, seriesId: heroItem.stream_id })
            if response.error = invalid and response.data.info <> invalid then info = xtream.normalizeVodInfo({ info: response.data.info }, heroItem)
        else
            info = xtream.fetchVodInfo(transport, { apiBase: ctx.apiBase, credentials: ctx.credentials, vodId: heroItem.stream_id, item: heroItem })
        end if
    end if
    m.top.result = { mode: "hero", info: info }
end sub
