import "pkg:/source/catalog/catalog.bs"
import "pkg:/source/catalog/catalogSearch.bs"
import "pkg:/source/search/searchScreen.bs"

sub init()
    m.top.functionName = "runSearch"
end sub

sub runSearch()
    port = CreateObject("roMessagePort")
    m.top.observeField("query", port)
    ctx = m.top.ctx
    hidden = m.top.hidden
    if hidden = invalid then hidden = {}
    cache = {}
    while true
        msg = wait(0, port)
        ' Só a última busca da fila: as anteriores já ficaram velhas.
        latest = invalid
        while msg <> invalid
            if type(msg) = "roSGNodeEvent" then latest = msg.getData()
            msg = port.getMessage()
        end while
        if latest <> invalid then
            if latest.stop = true then return
            answer(latest, ctx, hidden, cache)
        end if
    end while
end sub

sub answer(query as object, ctx as object, hidden as object, cache as object)
    try
        found = catalogSearch.search(ctx.dir, query.text, query.sections, searchScreen.RESULTS_PER_SECTION, hidden, cache)
        m.top.result = { seq: query.seq, ok: true, results: found.results, counts: found.counts }
    catch e
        ' Sem isto a falha aparecia como "Nenhum resultado".
        print "[search] Falha na busca: "; e.message
        m.top.result = { seq: query.seq, ok: false, results: [], counts: {} }
    end try
end sub
