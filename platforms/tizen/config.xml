<?xml version="1.0" encoding="UTF-8"?>
<!--
  Manifesto Samsung Tizen (TV). Versão e id do pacote são preenchidos por scripts/package-tv.mjs.
  O id do pacote (10 caracteres) deve ser o do seu certificado de distribuição Samsung
  (variável PULSE_TIZEN_PACKAGE_ID).
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://pulseplayer.app/__TIZEN_PACKAGE_ID__" version="__VERSION__" viewmodes="maximized">
  <tizen:application id="__TIZEN_PACKAGE_ID__.PulsePlayer" package="__TIZEN_PACKAGE_ID__" required_version="5.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>Pulse Player</name>
  <!-- internet: falar com os servidores do usuário. tv.inputdevice: teclas de mídia e canal do controle.
       productinfo (nível público): DUID da TV, usado como código do aparelho na licença (RFC-018). -->
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
  <!-- O usuário informa servidores arbitrários: não há como listar as origens antecipadamente. -->
  <access origin="*" subdomains="true"/>
</widget>
